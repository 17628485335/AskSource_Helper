# 复制为 .env 后按需修改（.env 已被 gitignore，切勿提交真实密钥）
#
# 注 1：auth 微服务配置（DATABASE_URL / JWT_*）已拆到独立的 auth/.env，
#       模板见 auth/.env.example。
#
# 注 2：以下 base_url 为各平台默认值，留空则回退 app/settings/llm.py 的
#       PROVIDER_BASE_URLS；/settings/model-providers 会返回生效地址供前端预填。
#       对话用的密钥由管理员在「设置-模型」页面写入数据库（llm_providers 表），
#       /chat 解析配置时不再以这里的密钥为准。

# 模型提供商 base_url（OpenAI 兼容 endpoint；嵌套字段用 __ 分隔）
DEEPSEEK__BASE_URL=https://api.deepseek.com/v1
SILICONFLOW__BASE_URL=https://api.siliconflow.cn/v1
BAILIAN__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选兜底：只有当数据库里那行的 api_key / default_model 为空时，build_model 才回退到这两项
# （换平台改前缀即可：DEEPSEEK__ / BAILIAN__）。正常部署留空。
SILICONFLOW__API_KEY=
SILICONFLOW__DEFAULT_MODEL=

# ---------- 联网搜索（app/settings/search.py） ----------
# 留空 = 不启用：ChatManager 建池时会跳过 web_search / read_url（模型图里根本没这两个工具），
# 纯对话不受影响。填上后重启后端即生效（配置带 lru_cache，不走数据库，无需迁移）。
# 密钥在 https://app.tavily.com 申请，形如 tvly-xxx；免费额度按月计。
TAVILY_API_KEY=
# 可选覆盖：走自建代理时改这里，默认 https://api.tavily.com
TAVILY_BASE_URL=
# 单次搜索超时（秒）：搜索夹在 ReAct 循环中间，拖太久不如让模型直接凭已有知识回答
SEARCH_TIMEOUT=8
# 单次读页超时（秒）：上游要真的去访问目标站点，比搜索慢，单独放宽
EXTRACT_TIMEOUT=15
