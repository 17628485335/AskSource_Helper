# auth 微服务独立配置模板（复制为 auth/.env 后按需修改；真实 .env 已被 gitignore）

# 数据库连接串（SQLAlchemy 异步 + aiomysql）
DATABASE_URL=mysql+aiomysql://root:root@127.0.0.1:3306/asksource?charset=utf8mb4

# JWT 配置：生产环境请用强随机值覆盖 JWT_SECRET_KEY
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# 刷新令牌有效期（天）：存于 HttpOnly Cookie + 后端数据库，登出可吊销
REFRESH_TOKEN_EXPIRE_DAYS=7
